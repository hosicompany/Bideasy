# Copy values into your local secret manager or shell environment.
# Do not commit a populated file.
CREATIVE_RUNNER_API_BASE=https://api.bideasy.kr
CREATIVE_RUNNER_API_PREFIX=/api/v1/creative-runner
CREATIVE_RUNNER_TOKEN=
CREATIVE_RUNNER_ID=operator-mac

# Non-secret workspace identifier selected locally with:
# higgsfield workspace set <workspace-id>
HIGGSFIELD_WORKSPACE_ID=
HIGGSFIELD_BIN=higgsfield
# Optional reference only; current allowlisted jobs never auto-apply the remote kit.
HIGGSFIELD_BRAND_KIT_ID=
CREATIVE_BRAND_POLICY_PATH=docs/CREATIVE_BRAND_KIT.json
CREATIVE_BRAND_ASSET_ROOT=infra/nginx/html
CREATIVE_RUNNER_FONT_DIR=frontend/assets/fonts

CREATIVE_RUNNER_INPUT_HOSTS=bideasy.kr,api.bideasy.kr
CREATIVE_RUNNER_POLL_SECONDS=15
CREATIVE_RUNNER_HEARTBEAT_SECONDS=60
CREATIVE_RUNNER_REQUEST_TIMEOUT_SECONDS=30
CREATIVE_RUNNER_COMMAND_TIMEOUT_SECONDS=2100
CREATIVE_RUNNER_HIGGSFIELD_WAIT_TIMEOUT=30m
CREATIVE_RUNNER_MAX_ASSET_BYTES=157286400
CREATIVE_RUNNER_FFMPEG_BIN=ffmpeg
CREATIVE_RUNNER_FFPROBE_BIN=ffprobe
