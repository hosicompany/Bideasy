  "edges": [
    {"from": "evaluation_contract", "to": "data_lineage_audit", "condition": "contract_frozen", "artifacts": ["evaluation_contract", "data_manifest_hash", "formula_hash"]},
    {"from": "evaluation_contract", "to": "formula_runtime_audit", "condition": "contract_frozen", "artifacts": ["evaluation_contract", "data_manifest_hash", "formula_hash"]},
    {"from": "evaluation_contract", "to": "rules_domain_audit", "condition": "contract_frozen", "artifacts": ["evaluation_contract", "data_manifest_hash", "formula_hash"]},
    {"from": "evaluation_contract", "to": "user_competitor_audit", "condition": "contract_frozen", "artifacts": ["evaluation_contract", "data_manifest_hash", "formula_hash"]},
    {"from": "data_lineage_audit", "to": "baseline_reproduction", "condition": "success", "artifacts": ["data_audit", "data_manifest_hash", "formula_hash"]},
    {"from": "formula_runtime_audit", "to": "baseline_reproduction", "condition": "success", "artifacts": ["formula_audit", "data_manifest_hash", "formula_hash"]},
    {"from": "rules_domain_audit", "to": "baseline_reproduction", "condition": "success", "artifacts": ["rules_audit", "data_manifest_hash", "formula_hash"]},
    {"from": "user_competitor_audit", "to": "baseline_reproduction", "condition": "success", "artifacts": ["evidence_audit", "data_manifest_hash", "formula_hash"]},
