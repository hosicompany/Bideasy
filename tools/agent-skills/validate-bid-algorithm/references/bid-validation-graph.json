    {"from": "independent_verifier", "to": "aborted", "condition": "abort_condition_or_budget_exhausted", "artifacts": ["verification_report", "data_manifest_hash", "formula_hash"]},
    {"from": "shadow_gate", "to": "audit_report", "condition": "gate_decided", "artifacts": ["gate_decision", "data_manifest_hash", "formula_hash"]},
    {"from": "aborted", "to": "audit_report", "condition": "failure_recorded", "artifacts": ["gate_decision", "data_manifest_hash", "formula_hash"]}
  ],
  "cycles": [
    {
      "nodes": ["candidate_builder", "independent_verifier"],
      "max_iterations": 3,
      "progress_signal": "preregistered primary metric improves without a hard-constraint regression",
      "abort_condition": "two consecutive iterations miss the minimum practical effect, leakage is unexplained, or a safety constraint fails",
      "success_exit": "shadow_gate",
      "failure_exit": "aborted"
    }
  ],
  "fan_in": [
    {
      "node": "baseline_reproduction",
      "required_predecessors": [
        "data_lineage_audit",
        "formula_runtime_audit",
        "rules_domain_audit",
        "user_competitor_audit"
      ],
      "required_artifacts": ["data_manifest_hash", "formula_hash"],
      "require_same_snapshot_hash": true
    }
  ],
  "approvals": []
