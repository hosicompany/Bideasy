    {"from": "contract_router", "to": "candidate_builder", "condition": "supported_route", "artifacts": ["route_plan", "verifier_feedback", "data_manifest_hash", "formula_hash"]},
    {"from": "candidate_builder", "to": "independent_verifier", "condition": "candidate_complete", "artifacts": ["candidate_report", "data_manifest_hash", "formula_hash"]},
    {"from": "independent_verifier", "to": "candidate_builder", "condition": "classified_failure_and_budget_remaining", "artifacts": ["verifier_feedback", "data_manifest_hash", "formula_hash"]},
