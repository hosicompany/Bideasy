{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend",
            "type": "process",
            "command": "${workspaceFolder}/backend/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe"
            },
            "args": [
                "-m",
                "uvicorn",
                "main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Info:     Will watch for changes in these directories:",
                    "endsPattern": "Info:     Uvicorn running on http://127.0.0.1:8000"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
