# BidEasy Production Environment Variables
# Copy to .env.production and fill in real values
# NEVER commit .env.production to git

# === Security (REQUIRED — generate unique values) ===
JWT_SECRET_KEY=          # openssl rand -base64 48
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# === Database ===
DATABASE_MODE=postgresql
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=bideasy
POSTGRES_PASSWORD=       # Strong password here
POSTGRES_DB=bideasy_db

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === External APIs (REQUIRED) ===
OPENAI_API_KEY=          # sk-...
PUBLIC_DATA_KEY=          # data.go.kr API key

# === OAuth — Kakao ===
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_NATIVE_APP_KEY=

# === OAuth — Naver ===
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === Toss Payments ===
TOSS_CLIENT_KEY=         # live_ key (not test_)
TOSS_SECRET_KEY=         # live_ secret
TOSS_WEBHOOK_SECRET=

# === Frontend URL ===
FRONTEND_URL=https://bideasy.kr

# === CORS ===
BACKEND_CORS_ORIGINS=["https://bideasy.kr","https://www.bideasy.kr"]

# === ML Models ===
ML_MODELS_PATH=./models
HISTORICAL_DB_PATH=./data/historical/bid_results_5years.db

# === App ===
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
AI_ANALYSIS_FREE_LIMIT=1

# === Creative workflow / permissioned message validation ===
# Generate with a password manager or `openssl rand -base64 48`; never commit real tokens.
CREATIVE_RUNNER_TOKEN_CURRENT=
CREATIVE_RUNNER_TOKEN_PREVIOUS=
CREATIVE_RUNNER_LEASE_SECONDS=300
HIGGSFIELD_CLI_VERSION=1.1.23
CREATIVE_ASSET_ROOT=/app/creative_assets
CREATIVE_ASSET_BASE_URL=/assets/generated
CREATIVE_MAX_UPLOAD_BYTES=157286400
CREATIVE_INPUT_ALLOWED_HOSTS=bideasy.kr,api.bideasy.kr
# Keep closed until a permissioned cohort and secret access key are ready.
MESSAGE_TEST_ENABLED=false
MESSAGE_TEST_ACCESS_KEYS=
MESSAGE_TEST_IMAGE_PATH=
MESSAGE_TEST_IMAGE_CAPTION=
CHROME_EXTENSION_ID=ecdpfnfonccaaneihkdlkhnkpjakmmnp

# === Firebase (FCM Push Notifications) ===
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json

# === Sentry ===
SENTRY_DSN=

# === Nginx ===
# Use ./nginx/conf.d-http for HTTP-only (before SSL setup)
# Switch to ./nginx/conf.d after SSL certificates are issued
NGINX_CONF_DIR=./nginx/conf.d-http
